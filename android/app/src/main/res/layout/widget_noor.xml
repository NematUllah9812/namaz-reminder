<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- dates row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#E8CF8A"
                android:textSize="13sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/w_greg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#93AD9F"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/w_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh widget" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:contentDescription="Noor Salah" />
    </LinearLayout>

    <!-- next prayer + countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#F3EAD3"
                android:textSize="17sp"
                android:letterSpacing="0.03" />

            <TextView
                android:id="@+id/w_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#93AD9F"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMAINING"
                android:textColor="#93AD9F"
                android:textSize="8sp"
                android:letterSpacing="0.28" />

            <Chronometer
                android:id="@+id/w_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format="%H:%M:%S"
                android:textColor="#E8CF8A"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33D4AF37"
        android:layout_marginBottom="8dp" />

    <!-- all five times -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FAJR" android:textColor="#5F7A6C" android:textSize="8sp" android:letterSpacing="0.18"/>
            <TextView android:id="@+id/w_fajr" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#93AD9F" android:textSize="11.5sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DHUHR" android:textColor="#5F7A6C" android:textSize="8sp" android:letterSpacing="0.18"/>
            <TextView android:id="@+id/w_dhuhr" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#93AD9F" android:textSize="11.5sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ASR" android:textColor="#5F7A6C" android:textSize="8sp" android:letterSpacing="0.18"/>
            <TextView android:id="@+id/w_asr" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#93AD9F" android:textSize="11.5sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MAGHRIB" android:textColor="#5F7A6C" android:textSize="8sp" android:letterSpacing="0.18"/>
            <TextView android:id="@+id/w_maghrib" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#93AD9F" android:textSize="11.5sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ISHA" android:textColor="#5F7A6C" android:textSize="8sp" android:letterSpacing="0.18"/>
            <TextView android:id="@+id/w_isha" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#93AD9F" android:textSize="11.5sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
